{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "REPLACE_WITH_MICROSOFT_APP_ID",
  "packageName": "com.aiscrummaster.teams",
  "developer": {
    "name": "AI Scrum Master",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "name": {
    "short": "AI Scrum Master",
    "full": "AI Scrum Master delivery agent"
  },
  "description": {
    "short": "Submit daily status and track delivery from Teams.",
    "full": "Collects daily status updates through an Adaptive Card or plain language, keeps task progress in sync, and relays blockers, missed submissions, deadlines and weekly packs to your project channels."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#14B8A6",
  "bots": [
    {
      "botId": "REPLACE_WITH_MICROSOFT_APP_ID",
      "scopes": ["personal", "team", "groupChat"],
      "isNotificationOnly": false,
      "supportsFiles": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            { "title": "status", "description": "Open today's daily status form" },
            { "title": "my tasks", "description": "List your open tasks and update progress" },
            { "title": "update ACME-3 70%", "description": "Set progress on one task" },
            { "title": "blocker <text>", "description": "Raise a blocker right away" },
            {
              "title": "leave 2026-08-03 to 2026-08-05 reason",
              "description": "Request leave for approval"
            },
            { "title": "mute", "description": "Stop direct messages from the agent" },
            { "title": "help", "description": "Show everything the agent can do" }
          ]
        },
        {
          "scopes": ["team", "groupChat"],
          "commands": [
            { "title": "standup", "description": "Today's submissions, hours and blockers" },
            { "title": "missing", "description": "Who has not submitted yet" },
            { "title": "report project <name>", "description": "Project metrics and RAG" },
            { "title": "help", "description": "Show everything the agent can do" }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["REPLACE_WITH_APP_DOMAIN"]
}
